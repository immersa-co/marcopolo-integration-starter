# Frontend
VITE_API_BASE_URL=http://localhost:8001

# Backend runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
APP_CORS_ORIGINS=http://localhost:5173
API_BASE_PATH=/api
PUBLIC_API_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:5173

# Session
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=marcopolo_integration_demo_session
SESSION_MAX_AGE_SECONDS=43200
SESSION_HTTPS_ONLY=false

# The demo uses a Test User email entry flow rather than a real product login.
AUTH_REQUIRED=true
AUTH_DEFAULT_RETURN_URL=http://localhost:5173/

# MarcoPolo target
MARCOPOLO_MCP_URL=https://mcp.marcopolo.dev
MARCOPOLO_API_BASE_URL=https://mcp.marcopolo.dev/api
MARCOPOLO_WEB_BASE_URL=https://mcp.marcopolo.dev
MARCOPOLO_BROWSER_BOOTSTRAP_PATH=/app/api/auth/bootstrap
MARCOPOLO_BROWSER_BOOTSTRAP_REDIRECT=/app/

# Default mode in the app is Developer API Token.
# Sign in to https://mcp.marcopolo.dev/app and create a Developer API Token.
MARCOPOLO_DEVELOPER_API_TOKEN=

# Optional: WorkOS Connect mode.
# Request these values from the Immersa / MarcoPolo team.
WORKOS_API_BASE_URL=https://api.workos.com
WORKOS_API_KEY=
WORKOS_CONNECT_AUTH_URL=
WORKOS_CONNECT_CLIENT_ID=
WORKOS_CONNECT_CLIENT_SECRET=
WORKOS_CONNECT_REDIRECT_URI=http://localhost:8001/api/auth/workos/callback
WORKOS_CONNECT_LOGIN_URI=http://localhost:8001/api/auth/workos/login
WORKOS_CONNECT_SCOPES=openid profile email offline_access
WORKOS_CONNECT_AUTHORIZE_PATH=/oauth2/authorize
WORKOS_CONNECT_TOKEN_PATH=/oauth2/token
WORKOS_CONNECT_COMPLETE_PATH=/authkit/oauth2/complete

# LLM runtime used by the Chatbot tab
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Clone the MarcoPolo plugin repo and point this at its skills directory:
# https://github.com/immersa-co/marcopolo-plugin
SKILL_REPO_PATH=
