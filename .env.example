# Frontend
VITE_API_BASE_URL=http://localhost:8001

# Backend runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
APP_CORS_ORIGINS=http://localhost:5173
API_BASE_PATH=/api
PUBLIC_API_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:5173

# Session
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=marcopolo_integration_demo_session
SESSION_MAX_AGE_SECONDS=43200
SESSION_HTTPS_ONLY=false

# The demo app-session form represents a user already authenticated by the
# partner application; it is not a real product login.
AUTH_REQUIRED=true
AUTH_DEFAULT_RETURN_URL=http://localhost:5173/

# MarcoPolo production endpoints for the partner integration flow.
MARCOPOLO_MCP_URL=https://mcp.marcopolo.dev
MARCOPOLO_API_BASE_URL=https://mcp.marcopolo.dev/api
MARCOPOLO_WEB_BASE_URL=https://mcp.marcopolo.dev

MARCOPOLO_BROWSER_BOOTSTRAP_PATH=/api/auth/bootstrap
MARCOPOLO_BROWSER_BOOTSTRAP_REDIRECT=/app/

# Recommended partner flow: a MarcoPolo-issued namespace key (mpk_...).
# Ask the MarcoPolo team for this value.
MARCOPOLO_NAMESPACE_KEY=get_from_marcopolo_team

# use to test against your own MarcoPolo account
MARCOPOLO_DEVELOPER_API_TOKEN=generate_from_your_marcopolo_web_app_developer_token_tab

# LLM runtime used by the Chatbot tab, providers anthropic and openai are supported
# out of the box, but you can modify the app to use any provider supported by Langgraph.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=generate_from_your_LLM_account

# Clone the MarcoPolo plugin repo and point this at its skills directory:
# https://github.com/immersa-co/marcopolo-plugin
SKILL_REPO_PATH=<github_repo_path>/marcopolo-plugin/skills
